@model video_site.Controllers.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<head>
    <link rel="stylesheet" href="~/css/sign.css">
    <script src="~/js/style/sign.js" defer></script>
    <title>Вход</title>
</head>

<body>
    <div class="bg-animation"></div>

    <div class="floating-elements">
        <div class="floating-element"></div>
        <div class="floating-element"></div>
        <div class="floating-element"></div>
    </div>

    <div class="auth-container">
        <div class="logo">
            <h1>Deal Hub</h1>
            <p>Добро пожаловать в будущее торговли</p>
        </div>

        <div class="auth-card">
            <!-- Переключатель форм -->
            <div class="form-toggle">
                <div class="toggle-indicator" id="toggleIndicator"></div>
                <button class="toggle-btn active" id="loginToggle" onclick="switchToLogin()">Вход</button>
                <button class="toggle-btn" id="registerToggle" onclick="switchToRegister()">Регистрация</button>
            </div>

            <!-- Форма входа -->
<!-- Форма входа -->
<form asp-controller="Account" asp-action="Sign" method="post" class="auth-form login-form" id="loginForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="mode" id="modeLogin" value="login" />

    <!-- общий вывод ошибок -->
    <div asp-validation-summary="All" class="validation-summary"></div>

    <div class="form-group">
        <input type="email" name="Email" id="loginEmail" class="form-input" placeholder="Email адрес" required>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="form-group">
        <input type="password" name="Password" id="loginPassword" class="form-input" placeholder="Пароль" required>
    </div>

    <button type="submit" class="submit-btn" onclick="submitForm(event, 'login')">
        <span class="loading-spinner"></span>
        Войти
    </button>

    <div class="auth-options">
        <a href="#" class="forgot-password">Забыли пароль?</a>
    </div>
</form>


<!-- Форма регистрации -->
<form asp-controller="Account" asp-action="Sign" method="post" class="auth-form register-form" id="registerForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="mode" id="modeRegister" value="register" />

    <!-- общий вывод ошибок -->
    <div asp-validation-summary="All" class="validation-summary"></div>

    <div class="form-group">
        <input type="text" name="FullName" id="registerFullName" class="form-input" placeholder="Полное имя" required>
    </div>
    <div class="form-group">
        <input type="email" name="Email" id="registerEmail" class="form-input" placeholder="Email адрес" required>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="form-group">
        <input type="password" name="Password" id="registerPassword" class="form-input" placeholder="Пароль" required>
    </div>
    <div class="form-group">
        <input type="password" name="ConfirmPassword" id="registerConfirmPassword" class="form-input" placeholder="Подтвердите пароль" required>
    </div>

    <div class="checkbox-group">
        <label class="custom-checkbox">
            <input type="checkbox" name="Agree" required>
            <span class="checkmark"></span>
        </label>
        <span>Я согласен с <a href="#" style="color: #feca57;">условиями использования</a></span>
    </div>

    <button type="submit" class="submit-btn" onclick="submitForm(event, 'register')">
        <span class="loading-spinner"></span>
        Создать аккаунт
    </button>
</form>

        </div>
    </div>
</body>
