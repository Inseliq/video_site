@model video_site.ViewModels.CatalogViewModel
@{
    ViewData["Title"] = "Каталог товаров";
}

<head>
    <link rel="stylesheet" href="~/css/catalog.css" />
    <script src="~/js/style/catalog.js" defer></script>
    <title>Каталог - Deal Hub</title>
</head>

<body>
    <div class="bg-animation"></div>

    <div class="floating-elements">
        <div class="floating-element"></div>
        <div class="floating-element"></div>
        <div class="floating-element"></div>
    </div>

    <!-- Hero секция каталога -->
    <section class="catalog-hero">
        <div class="hero-content">
            <h1>Каталог товаров</h1>
            <p>Откройте для себя тысячи качественных товаров от проверенных продавцов</p>

            <!-- Поисковая строка -->
            <div class="search-container">
                <form asp-controller="Catalog" asp-action="Search" method="get" class="search-form">
                    <div class="search-box">
                        <input type="text" name="query" value="@Model.SearchQuery" placeholder="Поиск товаров..." class="search-input">
                        <button type="submit" class="search-btn">
                            <span>🔍</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- Фильтры и сортировка -->
    <section class="filters-section">
        <div class="container">
            <div class="filters-container">
                <div class="categories-filter">
                    <h3>Категории</h3>
                    <div class="category-pills">
                        <a href="@Url.Action("Index", "Catalog", new { category = "all", sort = Model.CurrentSort })"
                           class="category-pill @(Model.CurrentCategory == "all" ? "active" : "")">
                           Все товары
                        </a>
                        <a href="@Url.Action("Index", "Catalog", new { category = "electronics", sort = Model.CurrentSort })"
                           class="category-pill @(Model.CurrentCategory == "electronics" ? "active" : "")">
                           Электроника
                        </a>
                        <a href="@Url.Action("Index", "Catalog", new { category = "fashion", sort = Model.CurrentSort })"
                           class="category-pill @(Model.CurrentCategory == "fashion" ? "active" : "")">
                           Одежда
                        </a>
                        <a href="@Url.Action("Index", "Catalog", new { category = "home", sort = Model.CurrentSort })"
                           class="category-pill @(Model.CurrentCategory == "home" ? "active" : "")">
                           Дом и сад
                        </a>
                        <a href="@Url.Action("Index", "Catalog", new { category = "sports", sort = Model.CurrentSort })"
                           class="category-pill @(Model.CurrentCategory == "sports" ? "active" : "")">
                           Спорт
                        </a>
                        <a href="@Url.Action("Index", "Catalog", new { category = "books", sort = Model.CurrentSort })"
                           class="category-pill @(Model.CurrentCategory == "books" ? "active" : "")">
                           Книги
                        </a>
                    </div>
                </div>

                <div class="sort-filter">
                    <form asp-controller="Catalog" asp-action="Index" method="get">
                        <input type="hidden" name="category" value="@Model.CurrentCategory" />
                        <input type="hidden" name="query" value="@Model.SearchQuery" />
                        <select name="sort" class="sort-select" onchange="this.form.submit()">
                            <option value="popular" selected="@(Model.CurrentSort == "popular")">По популярности</option>
                            <option value="price-low" selected="@(Model.CurrentSort == "price-low")">Сначала дешевые</option>
                            <option value="price-high" selected="@(Model.CurrentSort == "price-high")">Сначала дорогие</option>
                            <option value="rating" selected="@(Model.CurrentSort == "rating")">По рейтингу</option>
                            <option value="new" selected="@(Model.CurrentSort == "new")">Новинки</option>
                        </select>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Каталог товаров -->
    <section class="catalog">
        <div class="container">
            <div class="catalog-stats">
                <span class="results-count">Найдено товаров: <span>@Model.TotalProducts</span></span>
            </div>

            <div class="products-grid">
                @foreach (var product in Model.Products)
                {
                    <div class="product-card" data-product-id="@product.Id" onclick="openProductModal(@product.Id)">
                        <div class="product-image">
                            <img src="@product.ImageUrl" alt="@product.Title" loading="lazy">
                            @if (!string.IsNullOrEmpty(product.Badge))
                            {
                                <div class="product-badge">@product.Badge</div>
                            }
                        </div>
                        <div class="product-info">
                            <h3 class="product-title">@product.Title</h3>
                            <div class="product-rating">
                                <span class="stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= product.Rating ? "star-filled" : "star-empty")">★</span>
                                    }
                                </span>
                                <span class="reviews">(@product.ReviewsCount)</span>
                            </div>
                            <div class="product-price">@product.Price.ToString("C", new System.Globalization.CultureInfo("ru-RU"))</div>
                            <div class="product-actions">
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn-primary" onclick="event.stopPropagation(); addToCartAnimation(this)">
                                        В корзину
                                    </button>
                                </form>
                                <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn-secondary" onclick="event.stopPropagation(); addToWishlistAnimation(this)">
                                        ❤
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.HasMoreProducts)
            {
                <div class="load-more-container">
                    <a href="@Url.Action("Index", "Catalog", new {
                        category = Model.CurrentCategory,
                        sort = Model.CurrentSort,
                        query = Model.SearchQuery,
                        page = Model.CurrentPage + 1
                    })" class="load-more-btn" onclick="loadMoreAnimation(this)">
                        <span class="loading-spinner"></span>
                        Загрузить еще
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- Модальное окно товара -->
    <div class="modal-overlay" id="productModal" onclick="closeModal()">
        <div class="modal-content" onclick="event.stopPropagation()">
            <button class="modal-close" onclick="closeModal()">×</button>
            <div class="modal-body">
                <div class="modal-image">
                    <img id="modalImage" src="" alt="">
                </div>
                <div class="modal-info">
                    <h2 id="modalTitle"></h2>
                    <div class="modal-rating">
                        <div class="stars" id="modalStars"></div>
                        <span id="modalReviews"></span>
                    </div>
                    <div class="modal-price" id="modalPrice"></div>
                    <div class="modal-description" id="modalDescription"></div>
                    <div class="modal-actions">
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" id="modalCartForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" id="modalProductId" />
                            <button type="submit" class="btn-primary">Добавить в корзину</button>
                        </form>
                        <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post" id="modalWishlistForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" id="modalWishlistProductId" />
                            <button type="submit" class="btn-secondary">В избранное</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Скрытые данные для JavaScript *@
    <script type="application/json" id="products-data">
        @Html.Raw(Json.Serialize(Model.Products))
    </script>
</body>